; Operator console theme — high-contrast dark palette (IMPLEMENTATION_PLAN.md S.8).
;
; Dark ground with bright text, not the reverse: the console sits beside a lit glass box,
; and a light UI throws reflections onto the very screens the operator is reading. Every
; foreground/background pair here clears WCAG AA (4.5:1) against its own panel, so the
; strip stays readable under room lighting rather than only on a desk at night.
;
; State is never carried by colour alone — the link strip changes its wording too, and a
; disabled button changes its border as well as its fill. Roughly one man in twelve cannot
; separate the green and amber used here.

[gd_resource type="Theme" load_steps=8 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_bg"]
bg_color = Color(0.055, 0.075, 0.098, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.22, 0.28, 0.34, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_fill"]
