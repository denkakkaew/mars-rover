; Engine configuration file.
; Mars Rover — touchscreen operator console (Section 5.1 of plan/storyboard.md)

config_version=5

[application]

config/name="Mars Rover Console"
config/description="Touchscreen operator console for the Mars rover sample-return mission."
run/main_scene="res://scenes/console.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

; Sized for the assumed console display: a 15.6" 1920x1080 touchscreen (~141 ppi).
; The panel is not chosen until step 0.4 of IMPLEMENTATION_PLAN.md — console.gd states
; the assumption in one place and audits every touch target against it at startup, so
; changing the panel means changing two constants and re-reading the audit.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
